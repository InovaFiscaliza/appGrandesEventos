{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit (uv)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "streamlit",
            "args": [
                "run",
                "abordagem.py",
                "--server.port=8501",
                "--server.fileWatcherType=none"
            ],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Streamlit main.py (uv)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "streamlit",
            "args": [
                "run",
                "main.py",
                "--server.port=8502",
                "--server.fileWatcherType=none"
            ],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
